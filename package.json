{
  "name": "mazerunner",
  "version": "1.0.0",
  "type": "module",
  "description": "MazeRunner - A blockchain-powered maze game",
  "scripts": {
    "copy-wasm": "mkdir -p public/wasm && cp -r node_modules/@linera/client/dist/* public/wasm/",
    "dev": "npm run copy-wasm && vite",
    "build": "npm run copy-wasm && vite build",
    "preview": "vite preview",
    "start": "vite --port 3000"
  },
  "keywords": [
    "blockchain",
    "game",
    "maze",
    "phaser",
    "javascript",
    "linera",
    "web3"
  ],
  "author": "MazeRunner Team",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@dynamic-labs/ethereum": "^4.45.0",
    "@dynamic-labs/ethereum-aa": "^4.45.0",
    "@dynamic-labs/sdk-api": "^0.0.822",
    "@dynamic-labs/sdk-react-core": "^4.45.0",
    "@linera/client": "^0.15.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.39.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
